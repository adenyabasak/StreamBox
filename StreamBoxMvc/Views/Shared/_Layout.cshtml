@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - StreamBox</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/streambox.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg stream-navbar">
            <div class="container-fluid px-5">

                <a class="navbar-brand logo" href="/Movie/Index">STREAMBOX</a>

                <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu">

                    <ul class="navbar-nav ms-5">
                        <li class="nav-item">
                            <a class="nav-link" href="/Movie/Index">Ana Sayfa</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Movie/Index">Filmler</a>
                        </li>

                    </ul>

                    <div class="ms-auto d-flex align-items-center">

                        <input class="search-box" placeholder="Film ara..." />

                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <span class="text-white me-3">
                                Admin Hesabı: @Context.Session.GetString("Username")
                            </span>

                            <a href="/Admin/Index" class="login-btn me-2">Admin Paneli</a>
                            <a href="/Account/Logout" class="login-btn">Çıkış Yap</a>
                        }
                        else if (Context.Session.GetString("Role") == "User")
                        {
                            <span class="text-white me-3">
                                User Hesabı: @Context.Session.GetString("Username")
                            </span>

                            <a href="/Account/Logout" class="login-btn">Çıkış Yap</a>
                        }
                        else
                        {
                            <a href="/Account/Login" class="login-btn me-2">Giriş Yap</a>
                            <a href="/Account/Register" class="login-btn">Kayıt Ol</a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="footer-logo">STREAMBOX</div>
            <p>Premium Movie Platform</p>
            <hr />
            <small>© 2026 StreamBox</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>