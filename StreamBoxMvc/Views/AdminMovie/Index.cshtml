@model List<StreamBoxMvc.Models.Movie>

@{
    ViewData["Title"] = "Film Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="stream-page">

    <div class="section-head">
        <div class="section-title">Film Yönetimi</div>
        <div class="section-line"></div>
    </div>

    <div class="mb-4">
        <a href="/AdminMovie/Create" class="play-btn">
            + Yeni Film Ekle
        </a>
    </div>

    <div class="table-responsive">

        <table class="table table-dark table-hover align-middle text-center">

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Poster</th>
                    <th>Film Adı</th>
                    <th>Açıklama</th>
                    <th>Yıl</th>
                    <th>Kategori</th>
                    <th>Sil</th>
                    <th>Güncelle</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.MovieId</td>

                        <td>

                            <img src="@item.ImageUrl"
                                 style="width:90px;height:120px;object-fit:cover;" />

                        </td>

                        <td>

                            <strong>@item.Title</strong>

                        </td>

                        <td style="max-width:300px;">

                            @item.Description

                        </td>

                        <td>

                            @item.ReleaseYear

                        </td>

                        <td>

                            @item.CategoryId

                        </td>

                        <td>

                            <a href="/AdminMovie/Delete/@item.MovieId"
                               class="btn btn-danger">

                                Sil

                            </a>

                        </td>

                        <td>

                            <a href="/AdminMovie/Update/@item.MovieId"
                               class="btn btn-warning">

                                Güncelle

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>