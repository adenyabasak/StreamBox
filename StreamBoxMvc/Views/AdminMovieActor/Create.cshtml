@model StreamBoxMvc.Models.MovieActor

@{
    ViewData["Title"] = "Film Oyuncu Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card bg-dark shadow-lg border-0">

    <div class="card-body">

        <h3 class="text-white mb-4">
            Film Oyuncu Eşleştirme
        </h3>

        <form method="post">

            <label class="text-white">Film</label>

            <select asp-for="MovieId"
                    asp-items="ViewBag.Movies"
                    class="form-select mb-3">
                <option value="">Film Seçiniz</option>
            </select>

            <label class="text-white">Oyuncu</label>

            <select asp-for="ActorId"
                    asp-items="ViewBag.Actors"
                    class="form-select mb-4">
                <option value="">Oyuncu Seçiniz</option>
            </select>

            <button class="btn btn-success">
                Kaydet
            </button>

            <a href="/AdminMovieActor"
               class="btn btn-secondary">
                Vazgeç
            </a>

        </form>

    </div>

</div>