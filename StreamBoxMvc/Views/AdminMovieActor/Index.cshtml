@model List<StreamBoxMvc.Models.MovieActorListDto>

@{
    ViewData["Title"] = "Film Oyuncu Eşleştirme";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-white fw-bold">🎬 Film Oyuncu Eşleştirme</h2>

    <a href="/AdminMovieActor/Create" class="btn btn-success">
        + Yeni Eşleştirme
    </a>
</div>

<div class="card bg-dark border-0 shadow-lg">
    <div class="card-body">

        <table class="table table-dark table-hover align-middle">

            <thead>

                <tr>

                    <th>#</th>

                    <th>Film</th>

                    <th>Oyuncu</th>

                    <th width="120">Sil</th>

                    <th width="120">Güncelle</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.MovieActorId</td>

                        <td>@item.MovieTitle</td>

                        <td>@item.ActorName</td>

                        <td>
                            <a href="/AdminMovieActor/Delete/@item.MovieActorId"
                               class="btn btn-danger btn-sm">
                                Sil
                            </a>
                        </td>

                        <td>
                            <a href="/AdminMovieActor/Update/@item.MovieActorId"
                               class="btn btn-warning btn-sm">
                                Güncelle
                            </a>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
</div>